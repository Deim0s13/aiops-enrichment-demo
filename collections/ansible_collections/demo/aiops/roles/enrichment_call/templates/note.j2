{# The work note (design 5.4): labelled as AI-generated and unreviewed, the model's analysis first, then
   the documented fix, then fixes researched in a vendor's documentation (DD29), then the model's own
   low-trust suggestions, each kind clearly apart (DD24), then what it was based on (the sanitised
   evidence, the passages and the documentation used), then the references needed to reconstruct it. #}
{% set a = enrichment_call_answer %}
{% set p = a.provenance | default({}) %}
{# Ends each part with one full stop: adds one only where the text has none. #}
{% set stop = '([^.])$' %}
{% set researched = a.suggestions | default([]) | selectattr('basis', 'equalto', 'research') | list %}
{% set ideas = a.suggestions | default([]) | rejectattr('basis', 'equalto', 'research') | list %}
{% set vendors = a.research_used | default([]) | map(attribute='source') | unique | join(' and ') %}
{% macro suggestion(s, n) %}
  {{ n }}. [{{ 'Investigate' if s.kind == 'investigate' else 'Possible fix' }}] {{ s.action | regex_replace(stop, '\\1.') }}{{ (' Why: ' ~ s.reason | regex_replace(stop, '\\1.')) if s.reason | default('') else '' }}
{% for step in s.steps | default([]) %}
     - {{ step | regex_replace(stop, '\\1.') }}
{% endfor %}
     {{ ('Who: ' ~ s.owner | regex_replace(stop, '\\1.') ~ ' ') if s.owner | default('') else '' }}{{ ('Verify: ' ~ s.verify | regex_replace(stop, '\\1.') ~ ' ') if s.verify | default('') else '' }}{{ ('Risk: ' ~ s.risk | regex_replace(stop, '\\1.') ~ ' ') if s.risk | default('') else '' }}[{{ s.citations | join(', ') }}]
{%- endmacro %}
{% set nouns = {'card': 'card number', 'email': 'email address', 'token': 'token', 'key': 'key', 'secret': 'secret value',
                'private_key': 'private key'} %}
[AI-generated enrichment | revision {{ enrichment_call_revision }} | not reviewed by an engineer]
Outcome: {{ 'enriched, with a documented fix' if a.status == 'enriched' else ('no documented fix; fixes researched in ' ~ vendors ~ '\'s documentation and the model\'s own suggestions are given' if researched else 'no documented fix, so only the model\'s low-trust suggestions are given') }} | Manual review required: {{ 'yes' if a.manual_review_required else 'no' }}
Summary: {{ a.summary }}
{% if a.symptoms | default([]) %}
Symptoms:
{% for s in a.symptoms %}
  - {{ s }}
{% endfor %}
{% endif %}
{% for c in a.likely_causes %}
Likely cause ({{ c.confidence | default('unknown') }}): {{ c.statement }} [{{ c.citations | join(', ') }}]{{ (' Documented in: ' ~ (c.documented_by | map('regex_replace', '#.*$', '') | unique | join(', ')) ~ '.') if c.documented_by | default([]) else '' }}
{% endfor %}
{% if a.next_steps %}
Next steps (documented fix, from approved knowledge):
{% for s in a.next_steps %}
  {{ loop.index }}. {{ s.step | regex_replace(stop, '\\1.') }}{{ (' Prerequisites: ' ~ s.prerequisites | regex_replace(stop, '\\1.')) if s.prerequisites | default('') else '' }}{{ (' Risk: ' ~ s.risk | regex_replace(stop, '\\1.')) if s.risk | default('') else '' }} Verify: {{ s.verify | default('n/a', true) | regex_replace(stop, '\\1.') }} [{{ s.citations | join(', ') }}]
{% endfor %}
{% endif %}
{% if researched %}
Researched fixes (from {{ vendors }}'s documentation, fetched for this incident; NOT approved by ACME, check before acting):
{% for s in researched %}
{{ suggestion(s, loop.index) }}
{% endfor %}
{% endif %}
{% if ideas %}
Suggestions from the model (LOW TRUST: not from approved knowledge or documentation; check them before acting):
{% for s in ideas %}
{{ suggestion(s, loop.index) }}
{% endfor %}
{% endif %}
{% if a.recommended_job %}
Recommended automation: {{ a.recommended_job.job_id }}: {{ a.recommended_job.reason | default('') }}{{ (' (inputs: ' ~ (a.recommended_job.inputs | dict2items | map(attribute='key') | zip(a.recommended_job.inputs | dict2items | map(attribute='value')) | map('join', '=') | join(', ')) ~ ')') if a.recommended_job.inputs | default({}) else '' }}
{% else %}
Recommended automation: none
{% endif %}
{% if a.gaps %}
Gaps:
{% for g in a.gaps %}
  - {{ g }}
{% endfor %}
{% else %}
Gaps: none
{% endif %}
{% if a.evidence_considered | default([]) %}
Evidence considered:
{% for e in a.evidence_considered %}
  - {{ e.fact }} [{{ e.id }}]
{% endfor %}
{% endif %}
{% if a.knowledge_used | default([]) %}
Knowledge used:
{% for k in a.knowledge_used %}
  - {{ k.id }}: {{ k.title }} ({{ ('relevance %.2f' | format(k.score | float)) if k.score is not none and not k.added_with else 'with ' ~ k.added_with }})
{% endfor %}
{% else %}
Knowledge used: none (see gaps)
{% endif %}
{% if a.research_used | default([]) %}
Vendor documentation used (not approved by ACME):
{% for d in a.research_used %}
  - {{ d.id }}: {{ d.title }}, updated {{ d.updated | default('', true) or 'unknown' }}, fetched {{ d.fetched_at | default('n/a') }} (relevance {{ '%.2f' | format(d.score | float) }}): {{ d.url }}
{% endfor %}
{% endif %}
{% if a.checks_removed | default([]) %}
Removed by the service's checks:
{% for n in a.checks_removed %}
  - {{ n }}
{% endfor %}
{% endif %}
{% if p.redactions | default({}) %}
Removed from the evidence before analysis: {% for kind, count in p.redactions | dictsort %}{{ count }} {{ nouns[kind] | default(kind) }}{{ 's' if count | int > 1 else '' }}{{ ', ' if not loop.last else '' }}{% endfor %}

{% endif %}
References: {{ ('trace ' ~ p.trace_id ~ ' (MLflow)') if p.trace_recorded | default(false) else ('trace not recorded, request ' ~ p.trace_id | default('n/a')) }} | model {{ p.model | default('', true) or 'n/a' }} | prompt {{ p.prompt_version | default('n/a') }} | policy {{ p.policy_version | default('n/a') }} | retrieval {{ p.retrieval_version | default('n/a') }}{{ (' | research ' ~ p.research.version) if (p.research | default({})).sources | default([]) else '' }} | service {{ p.service_version | default('n/a') }} | tokens {{ (p.tokens.prompt | default(0)) + (p.tokens.completion | default(0)) if p.tokens is defined else 'n/a' }}{{ (' | ' ~ enrichment_call_references) if enrichment_call_references | default('') else '' }}
