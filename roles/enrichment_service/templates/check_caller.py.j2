# Runs in a Job in the caller's namespace: health, a call without the token, and a call with it. The
# call with the token goes the whole way: sanitisation, retrieval as the read-only identity, the model
# through the gateway and the service's checks. Its evidence carries a test card number, which must
# not come back. A second call, for a failure no approved knowledge covers (MessageHub throttling, S2),
# must be researched in the allow-listed vendor documentation (DD29). A third drafts a resolution
# from an engineer's resolution notes (DD33), for phase 06 to check against the template.
import json
import os
import ssl
import urllib.error
import urllib.request

url = os.environ["URL"]
context = ssl.create_default_context(cafile="/etc/ca/service-ca.crt")
incident = {
    "incident": {"sys_id": "0" * 32, "number": "INC0000000", "cmdb_ci": "payments-notify", "priority": "2",
                 # Worded as the memory fault's alert words it, so the document gate (DD27) sees a real description.
                 "short_description": "Phase 06 build check: payments-notify was terminated for exceeding its memory "
                                      "limit (OOMKilled) and restarted"},
    "service_version": "2.4.1",
    "evidence": [
        {"id": "EV-POD-01", "source": "openshift.pod_status", "target": "demo-payments/payments-notify",
         "fact": "Container payments-notify restarted; last termination OOMKilled, exit code 137."},
        {"id": "EV-LOG-01", "source": "openshift.logs", "target": "demo-payments/payments-notify",
         "fact": "WARN NotificationTemplateCache size growing, entries are never evicted. "
                 "Notification sent for card 4111 1111 1111 1111."},
    ],
    "context": {"event_id": "phase 06 build check"},
    "catalogue": [{"id": "payments-heapdump-restart",
                   "description": "Capture a heap dump from one payments-notify pod, then restart that pod."}],
}


throttling = {
    "incident": {"sys_id": "1" * 32, "number": "INC0000001", "cmdb_ci": "payments-notify", "priority": "2",
                 "short_description": "Phase 06 build check: payments-notify customer confirmations are queuing: "
                                      "MessageHub is refusing deliveries"},
    "service_version": "2.4.1",
    "evidence": [
        {"id": "EV-LOG-01", "source": "openshift.logs", "target": "demo-payments/payments-notify",
         "fact": "WARN MessageHub returned HTTP 429 Too Many Requests for client acme-payments-notify (Retry-After: 30); "
                 "delivery retry 3 of 5 deferred; backlog 2100 notifications."},
    ],
    "context": {"event_id": "phase 06 research check"},
    "catalogue": [],
}


resolution = {
    "id": "KB-RS-999",
    "incident": {"sys_id": "2" * 32, "number": "INC0000002", "cmdb_ci": "payments-notify", "priority": "2",
                 "short_description": "Phase 06 build check: payments-notify customer confirmations are queuing",
                 "opened_at": "2026-11-04 02:27:45", "resolved_at": "2026-11-04 02:52:10",
                 "close_code": "Workaround provided"},
    "close_notes": ("What you saw:\nMessageHub refused deliveries with HTTP 429 and the backlog grew.\n\n"
                    "What you checked:\nThe MessageHub status page showed degraded mode in our region.\n\n"
                    "What fixed it:\nWe paused sending and waited for MessageHub to recover, then the backlog drained.\n\n"
                    "What to do next time:\nCheck the MessageHub status page first."),
    "ai_note": "", "service_version": "2.4.1", "owner": "Payments Platform Operations",
    "context": {"event_id": "phase 06 draft check"},
}


def call(path, body=None, token=None, timeout=15):
    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = "Bearer " + token
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(url + path, data=data, headers=headers, method="POST" if data else "GET")
    try:
        with urllib.request.urlopen(request, context=context, timeout=timeout) as response:
            return response.status, json.loads(response.read())
    except urllib.error.HTTPError as error:
        try:
            return error.code, json.loads(error.read())
        except ValueError:
            return error.code, {}
    except Exception as error:  # noqa: BLE001 - reported, not raised
        return -1, {"error": str(error)[:200]}


health = call("/healthz")
no_token = call("/v1/enrich", incident)
with_token = call("/v1/enrich", incident, os.environ["TOKEN"], timeout=600)
provenance = with_token[1].get("provenance", {})
researched = call("/v1/enrich", throttling, os.environ["TOKEN"], timeout=600) if os.environ.get("RESEARCH") == "1" else (0, {})
drafted = call("/v1/draft-resolution", resolution, os.environ["TOKEN"], timeout=600)
print(json.dumps({
    "health": health[0],
    "no_token": no_token[0],
    "with_token": with_token[0],
    "status": with_token[1].get("status"),
    "keys": sorted(with_token[1].keys()),
    "detail": str(with_token[1].get("detail", ""))[:300],
    "prompt_version": provenance.get("prompt_version"),
    "policy_version": provenance.get("policy_version"),
    "service_version": provenance.get("service_version"),
    "review": {k: with_token[1].get("review", {}).get(k) for k in ("status", "claims", "supported")}
              | {"partly": len(with_token[1].get("review", {}).get("partly", [])),
                 "removed": len(with_token[1].get("review", {}).get("removed", []))},
    "repeats": provenance.get("repeats", {}).get("compared", []),
    "seconds": provenance.get("calls", {}),
    "candidates": provenance.get("candidates", [])[:3],
    "source_ids": provenance.get("source_ids", []),
    "tokens": provenance.get("tokens", {}),
    "redactions": provenance.get("redactions", {}),
    "card_returned": "4111" in json.dumps(with_token[1]),
    "trace_id": provenance.get("trace_id"),
    "trace_recorded": provenance.get("trace_recorded", False),
    "error": health[1].get("error") or with_token[1].get("error"),
    "draft": {
        "status": drafted[0],
        "filename": drafted[1].get("filename", ""),
        "markdown": drafted[1].get("markdown", ""),
        "sections": drafted[1].get("sections", []),
        "unsupported": len(drafted[1].get("unsupported", [])),
        "detail": str(drafted[1].get("detail", ""))[:300],
    },
    "research": {
        "status": researched[0],
        "used": [{"id": d.get("id"), "score": d.get("score")} for d in researched[1].get("research_used", [])],
        "researched_fixes": sum(1 for x in researched[1].get("suggestions", []) if x.get("basis") == "research"),
        "notes": [g for g in researched[1].get("gaps", []) if "documentation" in g][:3],
        "detail": str(researched[1].get("detail", ""))[:300],
    },
}))
